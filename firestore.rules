rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // JIDDA STANDARD ACADEMY FIRESTORE SECURITY RULES
    // ============================================================
    //
    // Roles:
    // super-admin
    // admin
    // teacher
    // student
    // parent
    //
    // IMPORTANT:
    // Access is denied by default.
    // ============================================================


    // ============================================================
    // USER PROFILE HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function myUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function myRole() {
      return myUser().data.role;
    }

    function accountIsActive() {
      return userExists()
        && myUser().data.status == "active";
    }

    function isSuperAdmin() {
      return accountIsActive()
        && myRole() == "super-admin";
    }

    function isAdmin() {
      return accountIsActive()
        && myRole() == "admin";
    }

    function isAdminOrSuperAdmin() {
      return isSuperAdmin() || isAdmin();
    }

    function isTeacher() {
      return accountIsActive()
        && myRole() == "teacher";
    }

    function isStudent() {
      return accountIsActive()
        && myRole() == "student";
    }

    function isParent() {
      return accountIsActive()
        && myRole() == "parent";
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      // Users can read their own profile.
      // Administrators can read user/team profiles.
      allow read: if accountIsActive()
        && (
          request.auth.uid == uid
          || isAdminOrSuperAdmin()
        );

      // Only administrators can create user profiles.
      allow create: if isAdminOrSuperAdmin();

      // Administrators can update any user.
      //
      // A normal user may update their own profile only while
      // keeping their role and account status unchanged.
      allow update: if isAdminOrSuperAdmin()
        || (
          accountIsActive()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // STUDENTS
    // ============================================================

    match /students/{studentId} {

      // Admin/Super Admin:
      // Full access.
      //
      // Teacher:
      // Read access for school operations.
      //
      // Student:
      // Own record only.
      //
      // Parent:
      // Child record only.
      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || (
          isStudent()
          && resource.data.authUid == request.auth.uid
        )
        || (
          isParent()
          && resource.data.parentUid == request.auth.uid
        );

      // Only administrators can create students.
      allow create: if isAdminOrSuperAdmin();

      // Administrators can update students.
      //
      // A student may update only permitted parts of their own
      // profile and cannot change ownership, class or admission no.
      allow update: if isAdminOrSuperAdmin()
        || (
          isStudent()
          && resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == resource.data.authUid
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.admissionNo == resource.data.admissionNo
          && request.resource.data.parentUid == resource.data.parentUid
        );

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // CLASSES
    // ============================================================

    match /classes/{classId} {

      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || isStudent()
        || isParent();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // SUBJECTS
    // ============================================================

    match /subjects/{subjectId} {

      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || isStudent()
        || isParent();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // TEACHERS
    // ============================================================

    match /teachers/{teacherId} {

      // Teachers need to read teacher records so the current
      // teacher portal can identify assignments.
      allow read: if isAdminOrSuperAdmin()
        || isTeacher();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // PARENTS
    // ============================================================

    match /parents/{parentId} {

      allow read: if isAdminOrSuperAdmin()
        || (
          isParent()
          && (
            resource.data.authUid == request.auth.uid
            || resource.data.uid == request.auth.uid
          )
        );

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin()
        || (
          isParent()
          && (
            resource.data.authUid == request.auth.uid
            || resource.data.uid == request.auth.uid
          )
        );

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // RESULTS
    // ============================================================

    match /results/{resultId} {

      // Administrators have full result control.
      //
      // Teachers currently require result read/write access.
      //
      // Students can only read their own results.
      //
      // Parents can only read results belonging to their children.
      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || (
          isStudent()
          && exists(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          )
          && get(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          ).data.authUid == request.auth.uid
        )
        || (
          isParent()
          && exists(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          )
          && get(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          ).data.parentUid == request.auth.uid
        );

      allow create: if isAdminOrSuperAdmin()
        || isTeacher();

      allow update: if isAdminOrSuperAdmin()
        || isTeacher();

      allow delete: if isAdminOrSuperAdmin()
        || isTeacher();
    }


    // ============================================================
    // ATTENDANCE
    // ============================================================

    match /attendance/{attendanceId} {

      // Admins and teachers need attendance access.
      //
      // Students/parents are allowed to read attendance records
      // used by the current portal.
      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || isStudent()
        || isParent();

      allow create: if isAdminOrSuperAdmin()
        || isTeacher();

      allow update: if isAdminOrSuperAdmin()
        || isTeacher();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // FEE STRUCTURE
    // ============================================================

    match /feeStructure/{feeId} {

      // Current student/parent fee pages require read access.
      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || isParent()
        || isStudent();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // FEE PAYMENTS
    // ============================================================

    match /feePayments/{paymentId} {

      // Admin/Super Admin:
      // Full access.
      //
      // Teacher:
      // Current portal requires read access.
      //
      // Student:
      // Own payments only.
      //
      // Parent:
      // Child payments only.
      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || (
          isStudent()
          && exists(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          )
          && get(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          ).data.authUid == request.auth.uid
        )
        || (
          isParent()
          && exists(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          )
          && get(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          ).data.parentUid == request.auth.uid
        );

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // PROMOTION HISTORY
    // ============================================================

    match /promotionHistory/{historyId} {

      // Admin/Super Admin can review promotion history.
      // Teachers can read it where needed.
      allow read: if isAdminOrSuperAdmin()
        || isTeacher();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // ACTIVITY LOG
    // ============================================================

    match /activityLog/{activityId} {

      // Only administrators can read audit history.
      allow read: if isAdminOrSuperAdmin();

      // Admins and teachers can create activity records.
      allow create: if isAdminOrSuperAdmin()
        || isTeacher();

      // Audit records cannot be edited.
      allow update: if false;

      // Only Super Admin can delete audit records.
      allow delete: if isSuperAdmin();
    }


    // ============================================================
    // SCHOOL SETTINGS
    // ============================================================
    //
    // Document:
    // schoolSettings/current
    //
    // Stores:
    // - Current academic session
    // - Current academic term
    //
    // All active portal users may READ the current academic
    // period because it is used throughout the portal.
    //
    // Only Admin/Super Admin can change it.
    // Only Super Admin can delete it.
    // ============================================================

    match /schoolSettings/{settingId} {

      allow read: if accountIsActive();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isSuperAdmin();
    }


    // ============================================================
    // ANNOUNCEMENTS
    // ============================================================

    match /announcements/{announcementId} {

      // All active portal users can read school announcements.
      allow read: if accountIsActive();

      // Only administrators can publish or modify announcements.
      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================
    //
    // Any collection not explicitly listed above is blocked.
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}