rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * =========================================================
     * AUTHENTICATION HELPERS
     * =========================================================
     */

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function myUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function myRole() {
      return userExists()
        ? myUser().role
        : null;
    }

    function accountIsActive() {
      return userExists()
        && myUser().status == "active";
    }

    function isSuperAdmin() {
      return accountIsActive()
        && myRole() == "super-admin";
    }

    function isAdmin() {
      return accountIsActive()
        && myRole() == "admin";
    }

    function isAdminOrSuperAdmin() {
      return isAdmin()
        || isSuperAdmin();
    }

    function isTeacher() {
      return accountIsActive()
        && myRole() == "teacher";
    }

    function isStudent() {
      return accountIsActive()
        && myRole() == "student";
    }

    function isParent() {
      return accountIsActive()
        && myRole() == "parent";
    }


    /*
     * =========================================================
     * RESULT STATUS
     * =========================================================
     *
     * OPEN:
     * Teachers can submit results through the secure API.
     *
     * LOCKED:
     * Results are finalized. Teacher editing is blocked.
     *
     * PUBLISHED:
     * Students and parents can view their results.
     */

    function currentResultStatus() {
      return get(
        /databases/$(database)/documents/schoolSettings/current
      ).data.resultStatus;
    }

    function resultsAreOpen() {
      return !exists(
        /databases/$(database)/documents/schoolSettings/current
      )
      || currentResultStatus() == "open"
      || currentResultStatus() == null;
    }

    function resultsArePublished() {
      return exists(
        /databases/$(database)/documents/schoolSettings/current
      )
      && currentResultStatus() == "published";
    }


    /*
     * =========================================================
     * USERS
     * =========================================================
     */

    match /users/{userId} {

      /*
       * A user can read their own account.
       * Admin/Super Admin can read all users.
       */
      allow read: if
        (
          signedIn()
          && request.auth.uid == userId
        )
        || isAdminOrSuperAdmin();

      /*
       * Only Admin/Super Admin can create users.
       */
      allow create: if
        isAdminOrSuperAdmin();

      /*
       * Admin/Super Admin can update users.
       *
       * Normal users may update their own profile,
       * but cannot change their role or account status.
       */
      allow update: if
        isAdminOrSuperAdmin()
        ||
        (
          signedIn()
          && request.auth.uid == userId
          && accountIsActive()
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      /*
       * Only Super Admin can delete users.
       */
      allow delete: if
        isSuperAdmin();
    }


    /*
     * =========================================================
     * STUDENTS
     * =========================================================
     */

    match /students/{studentId} {

      /*
       * Admin/Super Admin:
       * full access.
       *
       * Teacher:
       * can read students.
       *
       * Student:
       * can read their own record.
       *
       * Parent:
       * can read their child.
       */
      allow read: if
        isAdminOrSuperAdmin()
        || isTeacher()
        ||
        (
          isStudent()
          && myUser().studentId == studentId
        )
        ||
        (
          isParent()
          && resource.data.parentUid == request.auth.uid
        );

      /*
       * Only Admin/Super Admin can create students.
       */
      allow create: if
        isAdminOrSuperAdmin();

      /*
       * Admin/Super Admin can update students.
       *
       * Students can update their own record,
       * but cannot change their class.
       */
      allow update: if
        isAdminOrSuperAdmin()
        ||
        (
          isStudent()
          && myUser().studentId == studentId
          && request.resource.data.classId == resource.data.classId
        );

      /*
       * Only Admin/Super Admin can delete students.
       */
      allow delete: if
        isAdminOrSuperAdmin();
    }


    /*
     * =========================================================
     * CLASSES
     * =========================================================
     */

    match /classes/{classId} {

      /*
       * All active users can read classes.
       */
      allow read: if
        accountIsActive();

      /*
       * Only Admin/Super Admin can manage classes.
       */
      allow create,
      update,
      delete: if
        isAdminOrSuperAdmin();
    }


    /*
     * =========================================================
     * SUBJECTS
     * =========================================================
     */

    match /subjects/{subjectId} {

      /*
       * All active users can read subjects.
       */
      allow read: if
        accountIsActive();

      /*
       * Only Admin/Super Admin can manage subjects.
       */
      allow create,
      update,
      delete: if
        isAdminOrSuperAdmin();
    }


    /*
     * =========================================================
     * TEACHERS
     * =========================================================
     */

    match /teachers/{teacherId} {

      /*
       * Admin/Super Admin and teachers can read
       * teacher records.
       */
      allow read: if
        isAdminOrSuperAdmin()
        || isTeacher();

      /*
       * Only Admin/Super Admin can manage teachers.
       */
      allow create,
      update,
      delete: if
        isAdminOrSuperAdmin();
    }


    /*
     * =========================================================
     * PARENTS
     * =========================================================
     */

    match /parents/{parentId} {

      /*
       * Admin/Super Admin can read all parents.
       *
       * Parent can read their own parent record.
       */
      allow read: if
        isAdminOrSuperAdmin()
        ||
        (
          isParent()
          &&
          (
            resource.data.authUid == request.auth.uid
            ||
            resource.data.uid == request.auth.uid
          )
        );

      /*
       * Only Admin/Super Admin can manage parents.
       */
      allow create,
      update,
      delete: if
        isAdminOrSuperAdmin();
    }


    /*
     * =========================================================
     * RESULTS
     * =========================================================
     *
     * IMPORTANT SECURITY DESIGN:
     *
     * Teachers DO NOT write results directly to Firestore.
     *
     * Teacher result submission must go through:
     *
     * /api/teacher/submit-result
     *
     * The secure server endpoint verifies:
     *
     * 1. Firebase session
     * 2. Active teacher account
     * 3. Teacher assignment
     * 4. Selected class
     * 5. Selected subject
     * 6. Form Master permissions
     * 7. Subject level
     * 8. Student/class relationship
     * 9. Result status
     * 10. CA/Exam scoring limits
     * 11. Grade and remark
     *
     * Admin SDK writes bypass Firestore rules.
     */

    match /results/{resultId} {

      /*
       * =======================================================
       * RESULT READ ACCESS
       * =======================================================
       */

      /*
       * Admin/Super Admin:
       * always allowed.
       *
       * Teacher:
       * can read results.
       *
       * Student:
       * can only read their own results AFTER publication.
       *
       * Parent:
       * can only read their child's results AFTER publication.
       */
      allow read: if
        isAdminOrSuperAdmin()
        || isTeacher()
        ||
        (
          isStudent()
          && resultsArePublished()
          && resource.data.studentId == myUser().studentId
        )
        ||
        (
          isParent()
          && resultsArePublished()
          && exists(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          )
          &&
          get(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          ).data.parentUid == request.auth.uid
        );


      /*
       * =======================================================
       * RESULT WRITE ACCESS
       * =======================================================
       */

      /*
       * ONLY Admin/Super Admin may write directly
       * to the results collection.
       *
       * Teachers must use:
       *
       * /api/teacher/submit-result
       *
       * This prevents a teacher from bypassing:
       *
       * - class assignment
       * - subject assignment
       * - Form Master permissions
       * - result lock
       * - result publication
       * - scoring validation
       */
      allow create,
      update,
      delete: if
        isAdminOrSuperAdmin();
    }


    /*
     * =========================================================
     * ATTENDANCE
     * =========================================================
     *
     * IMPORTANT:
     *
     * Teachers DO NOT write attendance directly.
     *
     * Teacher attendance submission must go through:
     *
     * /api/teacher/submit-attendance
     *
     * That server endpoint enforces:
     *
     * JSS1 - JSS3:
     * ONLY Form Master can take attendance.
     *
     * SS1 - SS3:
     * ONLY Form Master can take attendance.
     *
     * Nursery/Primary:
     * Existing assigned-teacher/Form-Master logic applies.
     *
     * Admin/Super Admin:
     * Full attendance control.
     */

    match /attendance/{attendanceId} {

      /*
       * Active users can read attendance.
       */
      allow read: if
        isAdminOrSuperAdmin()
        || isTeacher()
        || isStudent()
        || isParent();

      /*
       * Teachers cannot directly create attendance.
       */
      allow create: if
        isAdminOrSuperAdmin();

      /*
       * Teachers cannot directly update attendance.
       */
      allow update: if
        isAdminOrSuperAdmin();

      /*
       * Teachers cannot directly delete attendance.
       */
      allow delete: if
        isAdminOrSuperAdmin();
    }


    /*
     * =========================================================
     * FEE STRUCTURE
     * =========================================================
     */

    match /feeStructure/{feeId} {

      /*
       * All active users can read fee structure.
       */
      allow read: if
        accountIsActive();

      /*
       * Only Admin/Super Admin can manage fee structure.
       */
      allow create,
      update,
      delete: if
        isAdminOrSuperAdmin();
    }


    /*
     * =========================================================
     * FEE PAYMENTS
     * =========================================================
     */

    match /feePayments/{paymentId} {

      /*
       * Admin/Super Admin and teachers can read payments.
       *
       * Students can read their own payments.
       *
       * Parents can read their child's payments.
       */
      allow read: if
        isAdminOrSuperAdmin()
        || isTeacher()
        ||
        (
          isStudent()
          && resource.data.studentId ==
            myUser().studentId
        )
        ||
        (
          isParent()
          &&
          exists(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          )
          &&
          get(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          ).data.parentUid ==
            request.auth.uid
        );

      /*
       * Only Admin/Super Admin can manage payments.
       */
      allow create,
      update,
      delete: if
        isAdminOrSuperAdmin();
    }


    /*
     * =========================================================
     * PROMOTION HISTORY
     * =========================================================
     */

    match /promotionHistory/{historyId} {

      /*
       * Admin/Super Admin and teachers can read
       * promotion history.
       */
      allow read: if
        isAdminOrSuperAdmin()
        || isTeacher();

      /*
       * Only Admin/Super Admin can create,
       * update or delete promotion history.
       */
      allow create,
      update,
      delete: if
        isAdminOrSuperAdmin();
    }


    /*
     * =========================================================
     * ACTIVITY LOG
     * =========================================================
     */

    match /activityLog/{activityId} {

      /*
       * Admin/Super Admin can read activity logs.
       */
      allow read: if
        isAdminOrSuperAdmin();

      /*
       * Admin/Super Admin and teachers can create logs.
       */
      allow create: if
        isAdminOrSuperAdmin()
        || isTeacher();

      /*
       * Only Admin/Super Admin can update logs.
       */
      allow update: if
        isAdminOrSuperAdmin();

      /*
       * Only Super Admin can delete logs.
       */
      allow delete: if
        isSuperAdmin();
    }


    /*
     * =========================================================
     * SCHOOL SETTINGS
     * =========================================================
     */

    match /schoolSettings/{settingId} {

      /*
       * All active users can read school settings.
       */
      allow read: if
        accountIsActive();

      /*
       * Admin/Super Admin can create/update settings.
       */
      allow create,
      update: if
        isAdminOrSuperAdmin();

      /*
       * Only Super Admin can delete settings.
       */
      allow delete: if
        isSuperAdmin();
    }


    /*
     * =========================================================
     * ANNOUNCEMENTS
     * =========================================================
     */

    match /announcements/{announcementId} {

      /*
       * All active users can read announcements.
       */
      allow read: if
        accountIsActive();

      /*
       * Only Admin/Super Admin can manage announcements.
       */
      allow create,
      update,
      delete: if
        isAdminOrSuperAdmin();
    }


    /*
     * =========================================================
     * DEFAULT DENY
     * =========================================================
     *
     * Anything not explicitly allowed above is denied.
     */

    match /{document=**} {

      allow read,
      write: if false;
    }
  }
}