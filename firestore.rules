rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function userExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function myUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function myRole() {
      return myUser().data.role;
    }

    function accountIsActive() {
      return userExists()
        && myUser().data.status == "active";
    }

    function isSuperAdmin() {
      return accountIsActive()
        && myRole() == "super-admin";
    }

    function isAdmin() {
      return accountIsActive()
        && myRole() == "admin";
    }

    function isAdminOrSuperAdmin() {
      return isSuperAdmin() || isAdmin();
    }

    function isTeacher() {
      return accountIsActive()
        && myRole() == "teacher";
    }

    function isStudent() {
      return accountIsActive()
        && myRole() == "student";
    }

    function isParent() {
      return accountIsActive()
        && myRole() == "parent";
    }


    // ============================================================
    // RESULT STATUS HELPERS
    // ============================================================

    function currentResultStatus() {
      return get(
        /databases/$(database)/documents/schoolSettings/current
      ).data.resultStatus;
    }

    function resultsAreOpen() {
      return !exists(
        /databases/$(database)/documents/schoolSettings/current
      )
      || currentResultStatus() == "open"
      || currentResultStatus() == null;
    }

    function resultsArePublished() {
      return exists(
        /databases/$(database)/documents/schoolSettings/current
      )
      && currentResultStatus() == "published";
    }


    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {

      allow read: if accountIsActive()
        && (
          request.auth.uid == uid
          || isAdminOrSuperAdmin()
        );

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin()
        || (
          accountIsActive()
          && request.auth.uid == uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
        );

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // STUDENTS
    // ============================================================

    match /students/{studentId} {

      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || (
          isStudent()
          && resource.data.authUid == request.auth.uid
        )
        || (
          isParent()
          && resource.data.parentUid == request.auth.uid
        );

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin()
        || (
          isStudent()
          && resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == resource.data.authUid
          && request.resource.data.classId == resource.data.classId
          && request.resource.data.admissionNo == resource.data.admissionNo
          && request.resource.data.parentUid == resource.data.parentUid
        );

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // CLASSES
    // ============================================================

    match /classes/{classId} {

      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || isStudent()
        || isParent();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // SUBJECTS
    // ============================================================

    match /subjects/{subjectId} {

      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || isStudent()
        || isParent();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // TEACHERS
    // ============================================================

    match /teachers/{teacherId} {

      allow read: if isAdminOrSuperAdmin()
        || isTeacher();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // PARENTS
    // ============================================================

    match /parents/{parentId} {

      allow read: if isAdminOrSuperAdmin()
        || (
          isParent()
          && (
            resource.data.authUid == request.auth.uid
            || resource.data.uid == request.auth.uid
          )
        );

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin()
        || (
          isParent()
          && (
            resource.data.authUid == request.auth.uid
            || resource.data.uid == request.auth.uid
          )
        );

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // RESULTS
    // ============================================================

    match /results/{resultId} {

      // ----------------------------------------------------------
      // ADMIN
      // ----------------------------------------------------------

      allow read: if isAdminOrSuperAdmin();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();


      // ----------------------------------------------------------
      // TEACHERS
      // ----------------------------------------------------------

      allow read: if isTeacher();

      allow create: if isTeacher()
        && resultsAreOpen();

      allow update: if isTeacher()
        && resultsAreOpen();

      allow delete: if isTeacher()
        && resultsAreOpen();


      // ----------------------------------------------------------
      // STUDENTS
      // ----------------------------------------------------------

      allow read: if isStudent()
        && resultsArePublished()
        && exists(
          /databases/$(database)/documents/students/$(resource.data.studentId)
        )
        && get(
          /databases/$(database)/documents/students/$(resource.data.studentId)
        ).data.authUid == request.auth.uid;

      allow create: if false;

      allow update: if false;

      allow delete: if false;


      // ----------------------------------------------------------
      // PARENTS
      // ----------------------------------------------------------

      allow read: if isParent()
        && resultsArePublished()
        && exists(
          /databases/$(database)/documents/students/$(resource.data.studentId)
        )
        && get(
          /databases/$(database)/documents/students/$(resource.data.studentId)
        ).data.parentUid == request.auth.uid;

      allow create: if false;

      allow update: if false;

      allow delete: if false;
    }


    // ============================================================
    // ATTENDANCE
    // ============================================================
    //
    // IMPORTANT SECURITY DESIGN:
    //
    // Teachers are NOT allowed to directly create/update/delete
    // attendance documents from the browser.
    //
    // Teacher attendance must go through:
    //
    // /api/teacher/submit-attendance
    //
    // The server API verifies:
    //
    // JSS1 -> SS3:
    // ONLY THE FORM MASTER
    //
    // Nursery/Primary:
    // Existing authorized teacher workflow
    //
    // Admin/Super Admin:
    // Full control
    //
    // This prevents a teacher from bypassing the Form Master
    // restriction by manually calling Firestore from the browser.
    // ============================================================

    match /attendance/{attendanceId} {

      // ----------------------------------------------------------
      // READ
      // ----------------------------------------------------------
      //
      // Existing read access is preserved.
      // ----------------------------------------------------------

      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || isStudent()
        || isParent();


      // ----------------------------------------------------------
      // CREATE
      // ----------------------------------------------------------
      //
      // ONLY Admin/Super Admin can directly create attendance
      // in Firestore.
      //
      // Teachers MUST use the secure server API.
      // ----------------------------------------------------------

      allow create: if isAdminOrSuperAdmin();


      // ----------------------------------------------------------
      // UPDATE
      // ----------------------------------------------------------
      //
      // ONLY Admin/Super Admin can directly update attendance
      // in Firestore.
      //
      // Teachers MUST use the secure server API.
      // ----------------------------------------------------------

      allow update: if isAdminOrSuperAdmin();


      // ----------------------------------------------------------
      // DELETE
      // ----------------------------------------------------------

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // FEE STRUCTURE
    // ============================================================

    match /feeStructure/{feeId} {

      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || isParent()
        || isStudent();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // FEE PAYMENTS
    // ============================================================

    match /feePayments/{paymentId} {

      allow read: if isAdminOrSuperAdmin()
        || isTeacher()
        || (
          isStudent()
          && exists(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          )
          && get(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          ).data.authUid == request.auth.uid
        )
        || (
          isParent()
          && exists(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          )
          && get(
            /databases/$(database)/documents/students/$(resource.data.studentId)
          ).data.parentUid == request.auth.uid
        );

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // PROMOTION HISTORY
    // ============================================================

    match /promotionHistory/{historyId} {

      allow read: if isAdminOrSuperAdmin()
        || isTeacher();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // ACTIVITY LOG
    // ============================================================

    match /activityLog/{activityId} {

      allow read: if isAdminOrSuperAdmin();

      allow create: if isAdminOrSuperAdmin()
        || isTeacher();

      allow update: if false;

      allow delete: if isSuperAdmin();
    }


    // ============================================================
    // SCHOOL SETTINGS
    // ============================================================

    match /schoolSettings/{settingId} {

      allow read: if accountIsActive();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isSuperAdmin();
    }


    // ============================================================
    // ANNOUNCEMENTS
    // ============================================================

    match /announcements/{announcementId} {

      allow read: if accountIsActive();

      allow create: if isAdminOrSuperAdmin();

      allow update: if isAdminOrSuperAdmin();

      allow delete: if isAdminOrSuperAdmin();
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}